<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SS2Revive.CatalogPublisher</AssemblyName>
    <RootNamespace>SS2Revive.CatalogPublisher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SS2Revive_Data\SS2Revive_Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SS2ReviveVersion</_Parameter1>
      <_Parameter2>$(SS2ReviveVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
