# Build output
bin/
obj/
*.user
*.suo
.vs/
.idea/
.vscode/

# Local machine paths live here and must never be published.
Directory.Build.user.props

# Planning and operational documents stay local; the two public repository guides are exceptions.
docs/
*.md
!/README.md
!/BUILDING.md

# BepInEx is linked from the README, never vendored here.
lib/
BepInEx/

# Packaged releases
dist/
*.zip

# Game files. Nothing extracted from the installed game belongs in here, including
# Inventory.dat, ProgressionConfig.json and the news tile artwork.
*.dat
assets/newsfeed/images/*.png

# Local Cloudflare Worker development. Never commit local state or secrets.
backend/node_modules/
backend/**/node_modules/
backend/**/.wrangler/
backend/**/.dev.vars
backend/**/.env*
backend/**/wrangler.production.jsonc
backend/**/coverage/
backend/**/dist/
backend/**/dist-production/
.pnpm-store/
